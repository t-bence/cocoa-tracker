# Telegram Configuration
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# AWS / IoT Configuration
BUCKET=your_s3_bucket_name
IOT_THING_NAME=your_iot_thing_name
IOT_SHADOW_NAME=your_iot_shadow_name

# Google Calendar Configuration
# This should be the full JSON string from your Service Account key file
GOOGLE_SERVICE_ACCOUNT_INFO='{"type": "service_account", ...}'
GOOGLE_CALENDAR_ID=primary

# LLM / OpenRouter Configuration
# If using OpenRouter, put your OpenRouter API key here
OPENAI_API_KEY=your_llm_api_key
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional overrides
# URL=https://bfz.hu/en/concerts-tickets/concerts-and-festivals/cocoa-concerts/
# STORAGE_FILE=dates.json
