# This is only used for local development

# Telegram Configuration
# Get your token from @BotFather on Telegram
TELEGRAM_TOKEN=your_bot_token_here
# Get your chat ID (e.g., from @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# AWS Configuration
# The S3 bucket where the notified dates cache (dates.json) will be stored
BUCKET=your_s3_bucket_name_here

# AWS IoT Configuration
# The name of your AWS IoT Thing
IOT_THING_NAME=your_thing_name_here
# Optional: The name of the shadow if using a named shadow
IOT_SHADOW_NAME=your_shadow_name_here

# Optional: Override the default storage filename
# STORAGE_FILE=dates.json
